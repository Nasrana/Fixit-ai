# ===================================================
# FIXIT AI — Environment Configuration Example
# ===================================================

# Google Gemini API Key (Server-side only — never exposed to client bundle)
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Base API URL (Optional in production/Vercel since relative /api works seamlessly)
# Leave empty for automatic relative API routing (recommended for Vercel/Vite)
# Only set if backend is hosted on a separate custom domain:
# VITE_API_URL=https://your-backend.vercel.app
VITE_API_URL=
